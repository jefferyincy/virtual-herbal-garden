# Virtual Herbal Garden - server environment
# Copy to .env and fill in real values. Never commit .env.

PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/herbal_garden

# Use long random strings in any real deployment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TTL=15m
REFRESH_TTL=7d

CLIENT_ORIGIN=http://localhost:5173

# Set to "production" to enable secure cookies + strict CORS. Anything else = dev mode.
NODE_ENV=development
